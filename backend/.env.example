# ---------------------------------------------------------------------------
# Nexus Comm backend - ENVIRONMENT TEMPLATE (DUMMY VALUES ONLY)
#
# Copy to `.env` and replace every CHANGE_ME_* value with a unique, random
# secret. NEVER commit the resulting `.env`: it is git-ignored and excluded
# from the Docker build context. Do not reuse these placeholder values.
#
# Generate strong secrets, e.g.:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL (used by the app) --------------------------------------------
# In the production compose stack this is built from POSTGRES_* below; set it
# manually only when the database is external. URL-encode special characters in
# the password.
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@postgres:5432/nexus_comm?schema=public

# --- Redis (used by the app) -------------------------------------------------
# In the production compose stack this is built from REDIS_PASSWORD below.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_OTP_PREFIX=otp:
REDIS_OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=3
OTP_WINDOW_SECONDS=900

# --- JWT (minimum 32 chars each; MUST be distinct) ---------------------------
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nexus-comm
JWT_AUDIENCE=nexus-mobile

# --- Cookies -----------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
REFRESH_COOKIE_NAME=nexus_rt

# --- CORS (comma-separated browser origins allowed to call the API) ----------
# Add the deployed frontend origin (e.g. your Vercel production URL).
CORS_ORIGINS=https://CHANGE_ME_FRONTEND_DOMAIN

# --- Twilio SMS (leave TWILIO_ACCOUNT_SID empty to use the custom REST SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Custom REST SMS gateway fallback ----------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_API_FROM=

# --- OTP ---------------------------------------------------------------------
OTP_LENGTH=6
OTP_DEV_ECHO=false

# --- Firebase Cloud Messaging (server-side push) -----------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Account restoration (offline backup keys) -------------------------------
BACKUP_KEY_PEPPER=CHANGE_ME_BACKUP_PEPPER_MIN_32_CHARS
BACKUP_CHALLENGE_TTL_SECONDS=120

# --- Signaling ---------------------------------------------------------------
SIGNALING_PING_INTERVAL_MS=25000
SIGNALING_MAX_BUFFER_SIZE=1048576

# --- B2B SaaS (comma-separated key|name|tier|webhookUrl) ---------------------
DSAIALAP_B2B_KEYS=
DSAIALAP_PUBLIC_HOST=CHANGE_ME_PUBLIC_HOST
MASKED_ORIGINS=https://CHANGE_ME_FRONTEND_DOMAIN

# ---------------------------------------------------------------------------
# CPaaS / telecom layer - OFF by default. Set ENABLE_CPAAS_LAYER=true to mount
# /api/cpaas, start the call-event consumer and the FreeSWITCH ESL client. All
# other settings below are inert while the layer is disabled.
# ---------------------------------------------------------------------------
ENABLE_CPAAS_LAYER=false
CPAAS_REDIS_PREFIX=cpaas:
CPAAS_CALL_EVENTS_CHANNEL=call:events:cpaas
CPAAS_CONSENT_TTL_DAYS=30
CPAAS_API_KEY_MAX_RPM=120
CPAAS_SMS_GSM_MAX_RPM=2
CPAAS_SMS_GSM_DAILY_CAP=30

# --- FreeSWITCH mod_esl (inbound). Password required to enable ESL. ----------
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=
FS_TRUNK_NAME=
FS_GSM_GATEWAY=
FS_DIALPLAN_CONTEXT=

# --- jambonz BYOC (licensed IGW/ICX trunk) -----------------------------------
JAMBONZ_API_BASE_URL=
JAMBONZ_ACCOUNT_SID=
JAMBONZ_API_TOKEN=
JAMBONZ_CARRIER=
JAMBONZ_CALLBACK_BASE_URL=
JAMBONZ_WEBHOOK_USERNAME=
JAMBONZ_WEBHOOK_PASSWORD=
JAMBONZ_WEBHOOK_SECRET=

# --- Jasmin licensed SMPP/HTTP gateway ---------------------------------------
JASMIN_HTTP_URL=
JASMIN_HTTP_USERNAME=
JASMIN_HTTP_PASSWORD=

# --- Android GSM relay (personal path, ADB-paired companion app) -------------
ANDROID_GSM_BASE_URL=
ANDROID_GSM_TOKEN=
ANDROID_GSM_DEVICE_ID=

# ===========================================================================
# Production compose stack variables (read by docker-compose.prod.yml only;
# the application itself does not read these).
# ===========================================================================

# Immutable backend image reference, pinned by digest (preferred in production).
# Example: ghcr.io/OWNER/REPO/backend@sha256:<64 hex chars>
BACKEND_IMAGE=ghcr.io/CHANGE_ME_OWNER/CHANGE_ME_REPO/backend@sha256:CHANGE_ME_DIGEST

# PostgreSQL bootstrap credentials (compose builds DATABASE_URL from these).
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=nexus_comm

# Redis password (compose builds REDIS_URL from this; required, cannot be empty).
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Public hostname / TLS (letsencrypt) settings for the bundled nginx proxy.
PUBLIC_HOST=CHANGE_ME_PUBLIC_HOST
LETSENCRYPT_EMAIL=CHANGE_ME_EMAIL
